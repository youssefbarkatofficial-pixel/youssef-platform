# HTML pages: short cache so Google re-indexes quickly
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: index, follow

# Root index
/
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: index, follow

# Static assets: long cache
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
