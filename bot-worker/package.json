{
  "name": "bot-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker AI Bot for Platform Bousala",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev --remote",
    "d1:init:local": "wrangler d1 execute bousala-db --local --file=./schema.sql",
    "d1:init:remote": "wrangler d1 execute bousala-db --remote --file=./schema.sql",
    "test": "node --test test/bot.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^5.5.4",
    "wrangler": "^3.80.0"
  }
}
