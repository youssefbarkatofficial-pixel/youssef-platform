# انسخ هذا الملف باسم .env ثم املأ القيم من إعدادات مشروع Firebase
# (Project settings ثم Your apps ثم Web app).
# المشروع على خطة Spark المجانية: Authentication وFirestore فقط (بدون Storage).
# ملاحظة: هذه القيم هوية عامة للتطبيق وليست كلمات سر، لكن لا ترفع ملف .env على GitHub أو GitLab.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# رابط خادم البوصلة (Cloudflare Worker)
VITE_BOT_URL=https://bot-worker.youssefbarkatofficial.workers.dev
